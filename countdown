<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Handshake AI - T-Minus Countdown & Milestone Tracker</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        autumn: {
                            50: '#fffbf5',
                            100: '#fff4e5',
                            200: '#ffe4c4',
                            300: '#ffd099',
                            400: '#ffb366',
                            500: '#f58a25',
                            600: '#d96814',
                            700: '#b2470e',
                            800: '#8c3312',
                            900: '#5c200c',
                            gold: '#dfa649',
                            ember: '#e05d26'
                        },
                        hud: {
                            bg: '#0f0a07',
                            glass: 'rgba(28, 20, 14, 0.65)',
                            border: 'rgba(223, 166, 73, 0.25)',
                            glow: 'rgba(245, 138, 37, 0.15)'
                        }
                    },
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        heading: ['"Cinzel"', 'serif'],
                        mono: ['"Space Grotesk"', 'monospace']
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #0c0806;
            background-image: 
                radial-gradient(circle at 15% 20%, rgba(224, 93, 38, 0.18) 0%, transparent 45%),
                radial-gradient(circle at 85% 75%, rgba(223, 166, 73, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 50% 50%, rgba(92, 32, 12, 0.2) 0%, transparent 70%);
            background-attachment: fixed;
            color: #f3e9df;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        /* Glassmorphism custom styling */
        .glass-panel {
            background: rgba(26, 18, 13, 0.65);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(223, 166, 73, 0.22);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.5), inset 0 0 0 1px rgba(255, 220, 180, 0.05);
        }

        .glass-card {
            background: rgba(38, 26, 18, 0.5);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(223, 166, 73, 0.18);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-card:hover {
            border-color: rgba(223, 166, 73, 0.45);
            box-shadow: 0 4px 20px rgba(245, 138, 37, 0.15);
            transform: translateY(-2px);
        }

        /* Ambient Glow Effect */
        .glow-gold {
            box-shadow: 0 0 25px rgba(223, 166, 73, 0.3);
        }

        .glow-ember {
            box-shadow: 0 0 25px rgba(224, 93, 38, 0.4);
        }

        /* Scanline Overlay Effect for Tech HUD aesthetic */
        .hud-scanlines {
            background: linear-gradient(
                rgba(18, 16, 16, 0) 50%, 
                rgba(0, 0, 0, 0.25) 50%
            );
            background-size: 100% 4px;
            pointer-events: none;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 10, 7, 0.8);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(223, 166, 73, 0.3);
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(223, 166, 73, 0.6);
        }

        /* Checkbox Custom styling */
        .custom-checkbox {
            appearance: none;
            width: 22px;
            height: 22px;
            border: 2px solid rgba(223, 166, 73, 0.5);
            border-radius: 6px;
            background: rgba(20, 14, 10, 0.6);
            cursor: pointer;
            position: relative;
            transition: all 0.2s ease;
        }
        .custom-checkbox:checked {
            background: linear-gradient(135deg, #dfa649, #e05d26);
            border-color: #ffd099;
        }
        .custom-checkbox:checked::after {
            content: '\f00c';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            color: #0c0806;
            font-size: 12px;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        /* Pulse Animations */
        @keyframes subtlePulse {
            0%, 100% { opacity: 0.8; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.02); }
        }
        .pulse-slow {
            animation: subtlePulse 4s infinite ease-in-out;
        }
    </style>
</head>
<body class="min-h-screen relative pb-12 overflow-x-hidden">
    <!-- Grid overlay effect -->
    <div class="fixed inset-0 bg-[linear-gradient(to_right,#1f161015_1px,transparent_1px),linear-gradient(to_bottom,#1f161015_1px,transparent_1px)] bg-[size:4rem_4rem] pointer-events-none"></div>

    <!-- Header HUD Bar -->
    <header class="border-b border-autumn-gold/20 bg-hud-bg/80 backdrop-blur-md sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Brand / Logo -->
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-autumn-gold to-autumn-ember flex items-center justify-center shadow-lg shadow-autumn-ember/20">
                    <i class="fa-solid fa-handshake text-autumn-900 font-bold text-xl"></i>
                </div>
                <div>
                    <div class="flex items-center space-x-2">
                        <span class="text-xs font-mono font-bold tracking-widest text-autumn-gold uppercase">Handshake AI Showcase</span>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono bg-autumn-gold/10 text-autumn-gold border border-autumn-gold/30">V2.4 HUD</span>
                    </div>
                    <h1 class="text-xl font-bold font-heading tracking-wide text-transparent bg-clip-text bg-gradient-to-r from-amber-100 via-autumn-200 to-autumn-gold">
                        T-Minus Countdown & Milestone Tracker
                    </h1>
                </div>
            </div>

            <!-- Stats & Quick Actions -->
            <div class="flex items-center space-x-4">
                <button onclick="openAddModal()" class="hidden sm:flex items-center space-x-2 px-4 py-2 rounded-lg bg-gradient-to-r from-autumn-gold/20 to-autumn-ember/20 hover:from-autumn-gold/30 hover:to-autumn-ember/30 border border-autumn-gold/40 text-autumn-200 text-sm font-medium transition duration-200 shadow-lg">
                    <i class="fa-solid fa-plus text-autumn-gold"></i>
                    <span>Add Milestone</span>
                </button>
                <button onclick="openLockscreenModal()" class="flex items-center space-x-2 px-4 py-2 rounded-lg bg-gradient-to-r from-autumn-gold to-autumn-ember text-autumn-900 font-bold text-sm hover:brightness-110 transition duration-200 shadow-lg shadow-autumn-ember/20">
                    <i class="fa-solid fa-mobile-screen"></i>
                    <span>Add to Lock Screen</span>
                </button>
                <div class="h-8 w-px bg-autumn-gold/20 hidden sm:block"></div>
                <div class="text-right hidden md:block">
                    <div class="text-[10px] font-mono text-autumn-300/70 uppercase">System Status</div>
                    <div class="text-xs font-mono text-emerald-400 flex items-center justify-end space-x-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span>LIVE SYNCHRONIZED</span>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 space-y-8 relative z-10">
        
        <!-- Top Banner / Goal Header -->
        <div class="glass-panel rounded-2xl p-6 sm:p-8 relative overflow-hidden">
            <!-- Background Decorative Glow -->
            <div class="absolute -right-16 -top-16 w-64 h-64 bg-autumn-ember/15 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -left-16 -bottom-16 w-64 h-64 bg-autumn-gold/10 rounded-full blur-3xl pointer-events-none"></div>
            
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 relative z-10">
                <div class="space-y-2">
                    <div class="flex items-center space-x-2">
                        <span class="px-3 py-1 rounded-full text-xs font-mono uppercase bg-autumn-ember/20 text-autumn-300 border border-autumn-ember/40">
                            Target Event: <span id="displayTargetName" class="font-bold text-white">Friendsgiving Gathering</span>
                        </span>
                        <span class="text-autumn-400 text-xs font-mono" id="displayTargetDate">Nov 17, 2026</span>
                    </div>
                    <h2 class="text-3xl sm:text-4xl font-extrabold font-heading text-white tracking-tight">
                        T-MINUS COUNTDOWN: <span class="text-transparent bg-clip-text bg-gradient-to-r from-autumn-gold via-autumn-300 to-autumn-ember" id="goalTitleHeading">FRIENDSGIVING</span>
                    </h2>
                    <p class="text-autumn-200/70 text-sm max-w-2xl">
                        AI-driven backward schedule optimization and real-time execution tracker. Monitor your automated milestones and ensure seamless target deployment.
                    </p>
                </div>

                <!-- Event Editor Quick Trigger -->
                <div class="flex flex-wrap gap-3 self-start lg:self-center">
                    <button onclick="openLockscreenModal()" class="px-4 py-2.5 rounded-xl bg-gradient-to-r from-autumn-gold/30 to-autumn-ember/30 hover:from-autumn-gold/40 hover:to-autumn-ember/40 border border-autumn-gold/40 text-xs font-mono text-white transition flex items-center space-x-2 shadow-md">
                        <i class="fa-solid fa-mobile-screen-button text-autumn-gold"></i>
                        <span>Lock Screen Options</span>
                    </button>
                    <button onclick="openTargetModal()" class="px-4 py-2.5 rounded-xl bg-autumn-800/40 hover:bg-autumn-700/50 border border-autumn-gold/30 text-xs font-mono text-autumn-200 transition flex items-center space-x-2">
                        <i class="fa-solid fa-pen-to-square text-autumn-gold"></i>
                        <span>Configure Goal</span>
                    </button>
                </div>
            </div>

            <!-- Main Countdown HUD Counters -->
            <div class="mt-8 grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
                <div class="bg-black/40 border border-autumn-gold/20 rounded-xl p-4 text-center backdrop-blur-md relative overflow-hidden group">
                    <div class="absolute inset-0 bg-autumn-gold/5 opacity-0 group-hover:opacity-100 transition"></div>
                    <div class="text-2xl sm:text-4xl font-extrabold font-mono text-autumn-gold" id="daysCount">00</div>
                    <div class="text-[10px] sm:text-xs font-mono text-autumn-300/60 uppercase tracking-widest mt-1">Days Remaining</div>
                </div>
                <div class="bg-black/40 border border-autumn-gold/20 rounded-xl p-4 text-center backdrop-blur-md relative overflow-hidden group">
                    <div class="absolute inset-0 bg-autumn-gold/5 opacity-0 group-hover:opacity-100 transition"></div>
                    <div class="text-2xl sm:text-4xl font-extrabold font-mono text-autumn-gold" id="hoursCount">00</div>
                    <div class="text-[10px] sm:text-xs font-mono text-autumn-300/60 uppercase tracking-widest mt-1">Hours</div>
                </div>
                <div class="bg-black/40 border border-autumn-gold/20 rounded-xl p-4 text-center backdrop-blur-md relative overflow-hidden group">
                    <div class="absolute inset-0 bg-autumn-gold/5 opacity-0 group-hover:opacity-100 transition"></div>
                    <div class="text-2xl sm:text-4xl font-extrabold font-mono text-autumn-gold" id="minutesCount">00</div>
                    <div class="text-[10px] sm:text-xs font-mono text-autumn-300/60 uppercase tracking-widest mt-1">Minutes</div>
                </div>
                <div class="bg-black/40 border border-autumn-gold/20 rounded-xl p-4 text-center backdrop-blur-md relative overflow-hidden group">
                    <div class="absolute inset-0 bg-autumn-gold/5 opacity-0 group-hover:opacity-100 transition"></div>
                    <div class="text-2xl sm:text-4xl font-extrabold font-mono text-autumn-ember" id="secondsCount">00</div>
                    <div class="text-[10px] sm:text-xs font-mono text-autumn-300/60 uppercase tracking-widest mt-1">Seconds</div>
                </div>
            </div>
        </div>

        <!-- Dashboard Body Layout -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            
            <!-- Left Column: Milestone Checklist (8 Cols) -->
            <div class="lg:col-span-8 space-y-6">
                <!-- Section Header with Progress Bar -->
                <div class="glass-panel rounded-2xl p-6">
                    <div class="flex items-center justify-between mb-4">
                        <div class="flex items-center space-x-3">
                            <div class="w-3 h-3 rounded-full bg-autumn-gold animate-ping"></div>
                            <h3 class="text-lg font-bold font-heading text-white">Target Milestones</h3>
                            <span class="text-xs font-mono px-2 py-0.5 rounded bg-autumn-gold/10 text-autumn-gold border border-autumn-gold/30" id="completedRatioText">0/7 Done</span>
                        </div>
                        <button onclick="openAddModal()" class="sm:hidden text-xs font-mono px-3 py-1.5 rounded bg-autumn-gold/20 text-autumn-200 border border-autumn-gold/30">
                            + Add Item
                        </button>
                    </div>

                    <!-- Main Overall Progress Bar -->
                    <div class="space-y-2">
                        <div class="flex justify-between text-xs font-mono">
                            <span class="text-autumn-300/80">Overall Timeline Completion</span>
                            <span class="text-autumn-gold font-bold" id="progressPercentageText">0%</span>
                        </div>
                        <div class="w-full h-3 bg-black/60 rounded-full overflow-hidden p-0.5 border border-autumn-gold/20">
                            <div id="mainProgressBar" class="h-full bg-gradient-to-r from-autumn-ember via-autumn-gold to-amber-300 rounded-full transition-all duration-500 shadow-lg shadow-autumn-gold/30" style="width: 0%"></div>
                        </div>
                    </div>
                </div>

                <!-- Milestone Cards List -->
                <div id="milestoneList" class="space-y-3">
                    <!-- Dynamic rendering will populate this area -->
                </div>
            </div>

            <!-- Right Column: AI Analytics & Controls (4 Cols) -->
            <div class="lg:col-span-4 space-y-6">
                
                <!-- Handshake AI Copilot Status Widget -->
                <div class="glass-panel rounded-2xl p-6 relative overflow-hidden">
                    <div class="flex items-center space-x-3 mb-4">
                        <div class="w-8 h-8 rounded-lg bg-autumn-gold/20 border border-autumn-gold/40 flex items-center justify-center text-autumn-gold">
                            <i class="fa-solid fa-robot"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-sm text-white font-heading">Handshake AI Agent</h4>
                            <p class="text-[10px] font-mono text-autumn-300/60">Automated Notification & Sync</p>
                        </div>
                    </div>

                    <div class="space-y-3 text-xs">
                        <div class="bg-black/40 border border-autumn-gold/15 p-3 rounded-xl flex items-center justify-between">
                            <span class="text-autumn-200/80">Daily Push Alert</span>
                            <span class="font-mono text-autumn-gold bg-autumn-gold/10 px-2 py-0.5 rounded border border-autumn-gold/30">09:00 AM</span>
                        </div>
                        <div class="bg-black/40 border border-autumn-gold/15 p-3 rounded-xl flex items-center justify-between">
                            <span class="text-autumn-200/80">Google Calendar Sync</span>
                            <span class="font-mono text-emerald-400 flex items-center space-x-1">
                                <i class="fa-solid fa-check text-[10px]"></i>
                                <span>Active</span>
                            </span>
                        </div>
                        <div class="bg-black/40 border border-autumn-gold/15 p-3 rounded-xl flex items-center justify-between">
                            <span class="text-autumn-200/80">Next Scheduled Milestone</span>
                            <span class="font-mono text-autumn-ember font-semibold" id="nextMilestoneTag">T-5 Days</span>
                        </div>
                    </div>

                    <div class="mt-4 pt-4 border-t border-autumn-gold/10">
                        <button onclick="triggerAiSync()" class="w-full py-2.5 rounded-xl bg-gradient-to-r from-autumn-gold/20 to-autumn-ember/20 hover:from-autumn-gold/30 hover:to-autumn-ember/30 border border-autumn-gold/30 text-xs font-mono text-autumn-gold font-semibold transition flex items-center justify-center space-x-2">
                            <i class="fa-solid fa-arrows-rotate animate-spin text-[10px]" id="syncSpinner" style="display:none;"></i>
                            <span>Sync Calendar & Alerts</span>
                        </button>
                    </div>
                </div>

                <!-- Summary Analytics HUD -->
                <div class="glass-panel rounded-2xl p-6 space-y-4">
                    <h4 class="font-bold text-sm text-white font-heading flex items-center justify-between">
                        <span>Milestone Breakdown</span>
                        <i class="fa-solid fa-chart-pie text-autumn-gold text-xs"></i>
                    </h4>

                    <div class="space-y-3">
                        <div>
                            <div class="flex justify-between text-xs mb-1 font-mono">
                                <span class="text-autumn-300/70">Completed Tasks</span>
                                <span class="text-emerald-400 font-bold" id="completedCountBadge">0</span>
                            </div>
                            <div class="w-full bg-black/40 h-1.5 rounded-full overflow-hidden">
                                <div id="completedCountBar" class="bg-emerald-400 h-full transition-all duration-300" style="width: 0%"></div>
                            </div>
                        </div>

                        <div>
                            <div class="flex justify-between text-xs mb-1 font-mono">
                                <span class="text-autumn-300/70">Pending Execution</span>
                                <span class="text-autumn-gold font-bold" id="pendingCountBadge">0</span>
                            </div>
                            <div class="w-full bg-black/40 h-1.5 rounded-full overflow-hidden">
                                <div id="pendingCountBar" class="bg-autumn-gold h-full transition-all duration-300" style="width: 0%"></div>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 rounded-xl bg-autumn-gold/5 border border-autumn-gold/15 text-[11px] text-autumn-200/80 leading-relaxed font-sans mt-2">
                        <i class="fa-solid fa-circle-info text-autumn-gold mr-1"></i>
                        Milestones working backward from target date ensure critical preparation steps are completed on schedule.
                    </div>
                </div>

                <!-- System Log / Activity Feed -->
                <div class="glass-panel rounded-2xl p-6">
                    <h4 class="font-bold text-sm text-white font-heading mb-3 flex items-center justify-between">
                        <span>Activity Audit Log</span>
                        <span class="text-[10px] font-mono text-autumn-300/50">REALTIME</span>
                    </h4>
                    <div id="activityLog" class="space-y-2 max-h-48 overflow-y-auto pr-1 text-[11px] font-mono text-autumn-300/80">
                        <!-- Dynamic log items -->
                    </div>
                </div>

            </div>

        </div>
    </main>

    <!-- Modal: Add / Edit Milestone -->
    <div id="milestoneModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="glass-panel max-w-md w-full rounded-2xl p-6 space-y-4 border border-autumn-gold/40 relative shadow-2xl">
            <div class="flex justify-between items-center border-b border-autumn-gold/20 pb-3">
                <h3 class="text-base font-bold text-white font-heading" id="modalTitle">Add Milestone</h3>
                <button onclick="closeMilestoneModal()" class="text-autumn-300/60 hover:text-white">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <form id="milestoneForm" onsubmit="saveMilestone(event)" class="space-y-4">
                <input type="hidden" id="milestoneId">
                <div>
                    <label class="block text-xs font-mono text-autumn-300 mb-1">T-Minus Day Offset</label>
                    <input type="number" id="milestoneOffset" required min="0" max="60" placeholder="e.g. 5" class="w-full bg-black/60 border border-autumn-gold/30 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-autumn-gold font-mono">
                </div>

                <div>
                    <label class="block text-xs font-mono text-autumn-300 mb-1">Milestone Action (Under 5-7 words)</label>
                    <input type="text" id="milestoneTitle" required placeholder="e.g. Purchase ingredients" class="w-full bg-black/60 border border-autumn-gold/30 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-autumn-gold">
                </div>

                <div>
                    <label class="block text-xs font-mono text-autumn-300 mb-1">Associated Icon</label>
                    <select id="milestoneIcon" class="w-full bg-black/60 border border-autumn-gold/30 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-autumn-gold font-mono">
                        <option value="fa-envelope">Envelope / Invites (fa-envelope)</option>
                        <option value="fa-clipboard-list">List / Menu (fa-clipboard-list)</option>
                        <option value="fa-users">Users / Delegate (fa-users)</option>
                        <option value="fa-cart-shopping">Shopping / Groceries (fa-cart-shopping)</option>
                        <option value="fa-broom">Broom / Cleaning (fa-broom)</option>
                        <option value="fa-utensils">Baking / Desserts (fa-utensils)</option>
                        <option value="fa-drumstick-bite">Turkey / Main Feast (fa-drumstick-bite)</option>
                        <option value="fa-flag-checkered">Flag / Goal (fa-flag-checkered)</option>
                    </select>
                </div>

                <div class="flex justify-end space-x-3 pt-2">
                    <button type="button" onclick="closeMilestoneModal()" class="px-4 py-2 rounded-xl border border-autumn-gold/20 text-xs text-autumn-300 hover:bg-autumn-gold/10 font-mono">
                        Cancel
                    </button>
                    <button type="submit" class="px-5 py-2 rounded-xl bg-gradient-to-r from-autumn-gold to-autumn-ember text-xs text-autumn-900 font-bold font-mono hover:brightness-110">
                        Save Milestone
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal: Target Goal Config -->
    <div id="targetModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <!-- ... existing target modal content ... -->
    </div>

    <!-- Modal: Lock Screen Integration -->
    <div id="lockscreenModal" class="fixed inset-0 bg-black/85 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden overflow-y-auto">
        <div class="glass-panel max-w-2xl w-full rounded-2xl p-6 sm:p-8 space-y-6 border border-autumn-gold/40 relative shadow-2xl my-8">
            <div class="flex justify-between items-center border-b border-autumn-gold/20 pb-4">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl bg-autumn-gold/20 border border-autumn-gold/40 flex items-center justify-center text-autumn-gold text-lg">
                        <i class="fa-solid fa-mobile-screen"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-bold text-white font-heading">Lock Screen Integration</h3>
                        <p class="text-xs font-mono text-autumn-300/70">Sync T-Minus countdown to your smartphone lock screen</p>
                    </div>
                </div>
                <button onclick="closeLockscreenModal()" class="text-autumn-300/60 hover:text-white p-2">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>

            <!-- Lockscreen Action Pathways Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- Option A: Wallpaper Generator -->
                <div class="bg-black/40 border border-autumn-gold/25 rounded-xl p-5 space-y-4 hover:border-autumn-gold/50 transition flex flex-col justify-between">
                    <div>
                        <div class="flex items-center space-x-2 text-autumn-gold font-mono text-xs font-bold uppercase mb-1">
                            <i class="fa-solid fa-image"></i>
                            <span>Pathway 1: Lock Wallpaper</span>
                        </div>
                        <h4 class="text-base font-bold text-white mb-2 font-heading">Download Custom 9:16 Wallpaper</h4>
                        <p class="text-xs text-autumn-200/70 leading-relaxed">
                            Generates a high-res lock screen graphic styled in autumn glassmorphism with an open clock area at the top and your latest milestone checklist.
                        </p>
                    </div>
                    <button onclick="generateAndDownloadWallpaper()" class="w-full py-2.5 rounded-xl bg-gradient-to-r from-autumn-gold to-autumn-ember text-autumn-900 font-bold text-xs font-mono flex items-center justify-center space-x-2 hover:brightness-110 transition shadow-lg">
                        <i class="fa-solid fa-download"></i>
                        <span>Generate & Download PNG</span>
                    </button>
                </div>

                <!-- Option B: ICS Calendar Export -->
                <div class="bg-black/40 border border-autumn-gold/25 rounded-xl p-5 space-y-4 hover:border-autumn-gold/50 transition flex flex-col justify-between">
                    <div>
                        <div class="flex items-center space-x-2 text-autumn-gold font-mono text-xs font-bold uppercase mb-1">
                            <i class="fa-solid fa-calendar-days"></i>
                            <span>Pathway 2: Live Widgets</span>
                        </div>
                        <h4 class="text-base font-bold text-white mb-2 font-heading">Export Calendar Reminders (.ics)</h4>
                        <p class="text-xs text-autumn-200/70 leading-relaxed">
                            Downloads a standard <code>.ics</code> file containing all scheduled T-Minus milestones for Apple Calendar, Google Calendar, or Outlook.
                        </p>
                    </div>
                    <button onclick="exportIcsFile()" class="w-full py-2.5 rounded-xl bg-autumn-800/60 border border-autumn-gold/40 text-autumn-gold font-bold text-xs font-mono flex items-center justify-center space-x-2 hover:bg-autumn-700/60 transition">
                        <i class="fa-solid fa-file-export"></i>
                        <span>Export .ICS Calendar File</span>
                    </button>
                </div>
            </div>

            <!-- Step-by-Step Device Setup Guide -->
            <div class="bg-black/30 border border-autumn-gold/15 rounded-xl p-5 space-y-4">
                <div class="flex items-center justify-between border-b border-autumn-gold/10 pb-3">
                    <h4 class="text-xs font-mono font-bold text-autumn-300 uppercase tracking-wider">Device Setup Instructions</h4>
                    <div class="flex space-x-2">
                        <button id="btnTabIos" onclick="switchGuideTab('ios')" class="px-3 py-1 rounded text-xs font-mono bg-autumn-gold/20 text-autumn-gold border border-autumn-gold/40">iOS (iPhone)</button>
                        <button id="btnTabAndroid" onclick="switchGuideTab('android')" class="px-3 py-1 rounded text-xs font-mono text-autumn-300/60 hover:text-white">Android</button>
                    </div>
                </div>

                <!-- iOS Instructions Tab -->
                <div id="guideIos" class="space-y-2 text-xs text-autumn-200/80 leading-relaxed font-sans">
                    <p><strong class="text-autumn-gold">Option 1 (Wallpaper):</strong> Save the generated PNG to Photos $\rightarrow$ Long-press Lock Screen $\rightarrow$ Add Photo Wallpaper. The top section is reserved for your iOS Clock.</p>
                    <p><strong class="text-autumn-gold">Option 2 (Live Reminders Widget):</strong> Import the downloaded <code>.ics</code> file into Apple Calendar. Long-press Lock Screen $\rightarrow$ Customize $\rightarrow$ Add <strong>Calendar</strong> or <strong>Reminders</strong> widget below the clock.</p>
                </div>

                <!-- Android Instructions Tab -->
                <div id="guideAndroid" class="space-y-2 text-xs text-autumn-200/80 leading-relaxed font-sans hidden">
                    <p><strong class="text-autumn-gold">Option 1 (Wallpaper):</strong> Open downloaded image in Gallery $\rightarrow$ Tap Options (...) $\rightarrow$ Set as Wallpaper $\rightarrow$ Lock screen.</p>
                    <p><strong class="text-autumn-gold">Option 2 (Google Calendar / Glance Widget):</strong> Import <code>.ics</code> to Google Calendar. Enable <strong>At a Glance</strong> widget on your lock screen to display upcoming T-minus reminders automatically.</p>
                </div>
            </div>

            <div class="flex justify-end pt-2">
                <button onclick="closeLockscreenModal()" class="px-5 py-2 rounded-xl border border-autumn-gold/20 text-xs text-autumn-300 hover:bg-autumn-gold/10 font-mono">
                    Close
                </button>
            </div>
        </div>
    </div>

    <!-- Hidden HTML5 Canvas for generating 9:16 Lockscreen Wallpaper -->
    <canvas id="wallpaperCanvas" class="hidden" width="1080" height="1920"></canvas>

    <!-- Toast Notification Widget -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
        <div class="glass-panel px-4 py-3 rounded-xl border border-autumn-gold/40 shadow-xl flex items-center space-x-3 text-xs font-mono text-white">
            <i class="fa-solid fa-circle-check text-autumn-gold text-base"></i>
            <span id="toastMsg">Action completed successfully.</span>
        </div>
    </div>

    <!-- Application Script -->
    <script>
        // Initial Target Configuration
        // Lock Screen Modal Handlers
        function openLockscreenModal() {
            document.getElementById('lockscreenModal').classList.remove('hidden');
        }

        function closeLockscreenModal() {
            document.getElementById('lockscreenModal').classList.add('hidden');
        }

        function switchGuideTab(os) {
            const btnIos = document.getElementById('btnTabIos');
            const btnAndroid = document.getElementById('btnTabAndroid');
            const guideIos = document.getElementById('guideIos');
            const guideAndroid = document.getElementById('guideAndroid');

            if (os === 'ios') {
                btnIos.className = "px-3 py-1 rounded text-xs font-mono bg-autumn-gold/20 text-autumn-gold border border-autumn-gold/40";
                btnAndroid.className = "px-3 py-1 rounded text-xs font-mono text-autumn-300/60 hover:text-white";
                guideIos.classList.remove('hidden');
                guideAndroid.classList.add('hidden');
            } else {
                btnAndroid.className = "px-3 py-1 rounded text-xs font-mono bg-autumn-gold/20 text-autumn-gold border border-autumn-gold/40";
                btnIos.className = "px-3 py-1 rounded text-xs font-mono text-autumn-300/60 hover:text-white";
                guideAndroid.classList.remove('hidden');
                guideIos.classList.add('hidden');
            }
        }

        // Dynamic 9:16 Canvas Lock Screen Wallpaper Generator
        function generateAndDownloadWallpaper() {
            const canvas = document.getElementById('wallpaperCanvas');
            const ctx = canvas.getContext('2d');
            const w = 1080;
            const h = 1920;

            // 1. Background Gradient (Dark Autumn Glow)
            const bgGradient = ctx.createLinearGradient(0, 0, 0, h);
            bgGradient.addColorStop(0, '#0a0705');
            bgGradient.addColorStop(0.4, '#170f0a');
            bgGradient.addColorStop(0.8, '#24140b');
            bgGradient.addColorStop(1, '#0d0704');
            ctx.fillStyle = bgGradient;
            ctx.fillRect(0, 0, w, h);

            // Ambient Glow Orbs
            const orb1 = ctx.createRadialGradient(w*0.8, h*0.2, 10, w*0.8, h*0.2, 500);
            orb1.addColorStop(0, 'rgba(224, 93, 38, 0.25)');
            orb1.addColorStop(1, 'transparent');
            ctx.fillStyle = orb1;
            ctx.fillRect(0, 0, w, h);

            const orb2 = ctx.createRadialGradient(w*0.2, h*0.7, 10, w*0.2, h*0.7, 600);
            orb2.addColorStop(0, 'rgba(223, 166, 73, 0.2)');
            orb2.addColorStop(1, 'transparent');
            ctx.fillStyle = orb2;
            ctx.fillRect(0, 0, w, h);

            // 2. Reserved Clock Area Line/Guide
            ctx.strokeStyle = 'rgba(223, 166, 73, 0.15)';
            ctx.setLineDash([8, 8]);
            ctx.beginPath();
            ctx.moveTo(80, 480);
            ctx.lineTo(w - 80, 480);
            ctx.stroke();
            ctx.setLineDash([]);

            ctx.fillStyle = 'rgba(255, 208, 153, 0.4)';
            ctx.font = '500 24px "Space Grotesk", sans-serif';
            ctx.textAlign = 'center';
            ctx.fillText('[ REFINED AREA FOR PHONE CLOCK WIDGET ]', w / 2, 450);

            // 3. Main Glass Card Container (Below Clock)
            const cardX = 80;
            const cardY = 530;
            const cardW = w - 160;
            const cardH = 1260;
            const radius = 32;

            // Card Background
            ctx.save();
            ctx.beginPath();
            ctx.roundRect(cardX, cardY, cardW, cardH, radius);
            ctx.fillStyle = 'rgba(28, 19, 13, 0.75)';
            ctx.fill();
            ctx.strokeStyle = 'rgba(223, 166, 73, 0.35)';
            ctx.lineWidth = 3;
            ctx.stroke();
            ctx.restore();

            // 4. Header Titles inside Card
            ctx.textAlign = 'center';
            ctx.fillStyle = '#dfa649';
            ctx.font = 'bold 32px "Space Grotesk", monospace';
            ctx.fillText('HANDSHAKE AI • T-MINUS COUNTDOWN', w / 2, cardY + 80);

            ctx.fillStyle = '#ffffff';
            ctx.font = 'bold 54px "Cinzel", serif';
            ctx.fillText(targetConfig.eventName.toUpperCase(), w / 2, cardY + 150);

            const formattedTarget = new Date(targetConfig.targetDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
            ctx.fillStyle = 'rgba(255, 244, 229, 0.7)';
            ctx.font = '400 28px "Plus Jakarta Sans", sans-serif';
            ctx.fillText(`Target Date: ${formattedTarget}`, w / 2, cardY + 195);

            // Divider Line
            ctx.strokeStyle = 'rgba(223, 166, 73, 0.2)';
            ctx.beginPath();
            ctx.moveTo(cardX + 60, cardY + 230);
            ctx.lineTo(cardX + cardW - 60, cardY + 230);
            ctx.stroke();

            // 5. Render Milestones List inside Card
            const sorted = [...milestones].sort((a, b) => b.offset - a.offset);
            let startY = cardY + 290;
            const itemH = 120;

            sorted.forEach((m, idx) => {
                if (idx > 6) return; // limit to fit nicely on canvas

                const itemY = startY + idx * itemH;
                const dateStr = getMilestoneFormattedDate(targetConfig.targetDate, m.offset);

                // Row background box
                ctx.beginPath();
                ctx.roundRect(cardX + 40, itemY, cardW - 80, 95, 16);
                ctx.fillStyle = m.completed ? 'rgba(223, 166, 73, 0.1)' : 'rgba(15, 10, 7, 0.5)';
                ctx.fill();
                ctx.strokeStyle = m.completed ? 'rgba(223, 166, 73, 0.4)' : 'rgba(223, 166, 73, 0.15)';
                ctx.lineWidth = 1.5;
                ctx.stroke();

                // Checkbox graphics
                const boxX = cardX + 75;
                const boxY = itemY + 30;
                ctx.beginPath();
                ctx.roundRect(boxX, boxY, 36, 36, 8);
                ctx.fillStyle = m.completed ? '#dfa649' : 'rgba(20, 14, 10, 0.8)';
                ctx.fill();
                ctx.strokeStyle = '#dfa649';
                ctx.lineWidth = 2;
                ctx.stroke();

                if (m.completed) {
                    ctx.fillStyle = '#0c0806';
                    ctx.font = 'bold 24px "Space Grotesk", sans-serif';
                    ctx.textAlign = 'center';
                    ctx.fillText('✓', boxX + 18, boxY + 27);
                }

                // Milestone text details
                ctx.textAlign = 'left';
                ctx.fillStyle = m.completed ? '#dfa649' : '#e05d26';
                ctx.font = 'bold 26px "Space Grotesk", monospace';
                ctx.fillText(`T-${m.offset} Days (${dateStr})`, cardX + 135, itemY + 45);

                ctx.fillStyle = m.completed ? 'rgba(255, 255, 255, 0.5)' : '#ffffff';
                ctx.font = `${m.completed ? '400' : '600'} 28px "Plus Jakarta Sans", sans-serif`;
                
                // Truncate text if too long
                let text = m.title;
                if (text.length > 28) text = text.substring(0, 26) + '...';
                ctx.fillText(text, cardX + 135, itemY + 78);
            });

            // Footer branding on wallpaper
            ctx.textAlign = 'center';
            ctx.fillStyle = 'rgba(223, 166, 73, 0.5)';
            ctx.font = '500 22px "Space Grotesk", monospace';
            ctx.fillText('GENERATED VIA HANDSHAKE AI AUTUMN HUD', w / 2, h - 70);

            // Trigger Image Download
            const link = document.createElement('a');
            link.download = `T-Minus-${targetConfig.eventName.replace(/\s+/g, '_')}-Wallpaper.png`;
            link.href = canvas.toDataURL('image/png');
            link.click();

            logActivity("Exported 9:16 lock screen wallpaper PNG.");
            showToast("Wallpaper downloaded! Set as your phone Lock Screen.");
        }

        // Export Standard .ICS Calendar File
        function exportIcsFile() {
            const targetDateObj = new Date(targetConfig.targetDate);
            let icsContent = [
                "BEGIN:VCALENDAR",
                "VERSION:2.0",
                "PRODID:-//Handshake AI//T-Minus Milestone Tracker//EN",
                "CALSCALE:GREGORIAN",
                "METHOD:PUBLISH"
            ];

            milestones.forEach(m => {
                const milestoneDate = new Date(targetDateObj);
                milestoneDate.setDate(targetDateObj.getDate() - m.offset);

                const year = milestoneDate.getFullYear();
                const month = String(milestoneDate.getMonth() + 1).padStart(2, '0');
                const day = String(milestoneDate.getDate()).padStart(2, '0');
                const dateStr = `${year}${month}${day}`;

                icsContent.push(
                    "BEGIN:VEVENT",
                    `UID:handshake-ai-${m.id}-${dateStr}@showcase.app`,
                    `DTSTAMP:${new Date().toISOString().replace(/[-:]/g, '').split('.')[0]}Z`,
                    `DTSTART;VALUE=DATE:${dateStr}`,
                    `SUMMARY:[T-${m.offset}] ${targetConfig.eventName}: ${m.title}`,
                    `DESCRIPTION:Handshake AI Milestone for ${targetConfig.eventName}. Status: ${m.completed ? 'Completed' : 'Pending'}`,
                    "BEGIN:VALARM",
                    "ACTION:DISPLAY",
                    `DESCRIPTION:Reminder: T-${m.offset} Milestone - ${m.title}`,
                    "TRIGGER:-PT9H", // Notification at 9:00 AM on scheduled date
                    "END:VALARM",
                    "END:VEVENT"
                );
            });

            icsContent.push("END:VCALENDAR");

            const blob = new Blob([icsContent.join("\r\n")], { type: "text/calendar;charset=utf-8" });
            const link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.download = `${targetConfig.eventName.replace(/\s+/g, '_')}_TMinus_Schedule.ics`;
            link.click();

            logActivity("Exported .ics calendar schedule.");
            showToast(".ICS Calendar file downloaded successfully!");
        }

        // Init App on Window Load
        window.onload = function() {
            renderMilestones();
            startCountdownEngine();
            logActivity("Dashboard initialized with Handshake AI core.");
        };
    </script>
</body>
</html>
